# =====================================
# Application
# =====================================

NODE_ENV=development
PORT=5000

FRONTEND_URL=https://hogenakkalhomestays.com/


# =====================================
# MongoDB
# =====================================

MONGO_URI=mongodb://127.0.0.1:27017/hhs


# =====================================
# Authentication
# =====================================

JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRES_IN=7d


# =====================================
# Booking configuration
# =====================================

BOOKING_HOLD_MINUTES=15
BOOKING_HOLD_CLEANUP_INTERVAL_MS=60000


# =====================================
# Email configuration
# =====================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=hogenakkalhomestays@gmail.com
SMTP_PASS=your_google_app_password

EMAIL_FROM_NAME=Hogenakkal Home Stays
EMAIL_FROM_ADDRESS=hogenakkalhomestays@gmail.com


# =====================================
# Razorpay payment configuration
# Keep empty until live payment setup
# =====================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# =====================================
# RazorpayX payout configuration
# Deferred until final deployment stage
# =====================================

RAZORPAYX_ACCOUNT_NUMBER=

PASSWORD_RESET_MINUTES=15
EMAIL_VERIFICATION_HOURS=24
